# Environment configuration template for Telegram OTT Giveaway Bot
# Copy this file to .env and fill in your details:
# cp .env.example .env

# Telegram Bot Token from @BotFather
TOKEN=your_telegram_bot_token_here

# Base URL for the web admin panel / Telegram WebApp (no trailing slash)
WEB_APP_URL=https://your-domain.com

# Channel ID for logs and announcements (e.g. -100xxxxxxxxxx)
CHANNEL_ID=-100xxxxxxxxxx

# Admin numeric Telegram IDs (comma-separated or single ID)
ADMIN_IDS=1234567890

# Admin Telegram usernames
ADMIN_USERNAMES=@your_username

# Web Admin Panel Credentials
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=your_secure_password_here
